{% extends "layout/base.html.twig" %}

{% block content %}
<!-- Cabecera -->
<div class="flex flex-col sm:flex-row justify-between items-start sm:items-center mb-6 gap-4">
    <h1 class="text-3xl font-extrabold text-gray-900 tracking-tight">Listado General</h1>
    <button id="btn-abrir-modal" class="bg-brand-500 text-gray-900 rounded-full px-6 py-2.5 text-sm font-semibold hover:bg-brand-600 hover:shadow-brand transition-all duration-300 whitespace-nowrap">
        + Nueva Reserva
    </button>
</div>

<!-- Barra de Filtros Combinados -->
<div class="bg-white p-4 rounded-2xl border border-gray-100 shadow-sm mb-6 flex flex-col md:flex-row gap-4 items-center justify-between">
    <div class="w-full md:w-1/3">
        <input type="text" id="filtro-nombre" placeholder="Buscar por huésped o ID..." class="w-full bg-gray-50 border border-gray-200 text-gray-700 text-sm rounded-full px-4 py-2.5 focus:outline-none focus:ring-2 focus:ring-brand-500 transition-shadow">
    </div>
    
    <div class="flex flex-col sm:flex-row items-center gap-3 w-full md:w-auto">
        <div class="flex items-center gap-2 bg-gray-50 border border-gray-200 rounded-full px-3 py-1.5 focus-within:ring-2 focus-within:ring-brand-500 transition-shadow">
            <input type="date" id="filtro-fecha-in" class="bg-transparent text-gray-600 text-sm outline-none cursor-pointer">
            <span class="text-gray-400 text-sm">-</span>
            <input type="date" id="filtro-fecha-out" class="bg-transparent text-gray-600 text-sm outline-none cursor-pointer">
        </div>

        <select id="filtro-estado" class="w-full sm:w-auto bg-gray-50 border border-gray-200 text-gray-700 text-sm rounded-full px-4 py-2.5 focus:outline-none focus:ring-2 focus:ring-brand-500 cursor-pointer transition-shadow">
            <option value="">Todos los estados</option>
            <option value="pendiente">Pendientes</option>
            <option value="confirmada">Confirmadas</option>
            <option value="cancelada">Canceladas</option>
        </select>
    </div>
</div>

<div class="bg-white rounded-2xl border border-gray-100 shadow-sm overflow-hidden">
    <div class="overflow-x-auto">
        <table class="w-full text-left border-collapse">
            <thead>
                <tr class="bg-gray-50/50 border-b border-gray-100 text-xs font-semibold text-gray-500 uppercase tracking-wider">
                    <th class="px-6 py-4">ID</th>
                    <th class="px-6 py-4">Huésped</th>
                    <th class="px-6 py-4">Fechas</th>
                    <th class="px-6 py-4">Estado</th>
                    <th class="px-6 py-4 text-right">Acciones</th>
                </tr>
            </thead>
            <tbody id="tabla-reservas" class="divide-y divide-gray-50">
                {% for reserva in reservas %}
                    <tr id="reserva-{{ reserva.id }}" class="hover:bg-gray-50/50 transition-colors duration-200">
                        <td class="px-6 py-4 text-sm text-gray-500">#{{ reserva.id }}</td>
                        <td class="px-6 py-4 text-sm font-medium text-gray-900">{{ reserva.nombre_huesped }}</td>
                        <td class="px-6 py-4 text-sm text-gray-600">{{ reserva.fecha_entrada }} <br><span class="text-xs text-gray-400">al {{ reserva.fecha_salida }}</span></td>
                        
                        <!-- DESPLEGABLE INTERACTIVO DE ESTADO (Sin lógica inline) -->
                        <td class="px-6 py-4">
                            <select data-id="{{ reserva.id }}" 
                                    class="select-estado text-xs font-semibold rounded-full px-3 py-1 border cursor-pointer focus:outline-none focus:ring-2 focus:ring-brand-500 transition-colors
                                    {% if reserva.estado == 'pendiente' %} bg-brand-50 text-brand-700 border-brand-200
                                    {% elseif reserva.estado == 'confirmada' %} bg-green-50 text-green-700 border-green-200
                                    {% else %} bg-red-50 text-red-700 border-red-200 {% endif %}">
                                <option value="pendiente" class="bg-white text-gray-900" {% if reserva.estado == 'pendiente' %}selected{% endif %}>Pendiente</option>
                                <option value="confirmada" class="bg-white text-gray-900" {% if reserva.estado == 'confirmada' %}selected{% endif %}>Confirmada</option>
                                <option value="cancelada" class="bg-white text-gray-900" {% if reserva.estado == 'cancelada' %}selected{% endif %}>Cancelada</option>
                            </select>
                        </td>
                        
                        <td class="px-6 py-4 text-right">
                            <a href="/detalle?id={{ reserva.id }}" class="text-brand-600 hover:text-brand-700 text-sm font-semibold transition-colors">Ver detalle</a>
                        </td>
                    </tr>
                {% else %}
                    <tr>
                        <td colspan="5" class="px-6 py-12 text-center text-gray-500">No se encontraron reservas.</td>
                    </tr>
                {% endfor %}
            </tbody>
        </table>
    </div>
</div>

<div id="modal-reserva" class="fixed inset-0 z-50 hidden" aria-labelledby="modal-title" role="dialog" aria-modal="true">
    <div id="modal-backdrop" class="fixed inset-0 bg-gray-900/60 backdrop-blur-sm transition-opacity"></div>
    <div class="fixed inset-0 z-10 w-screen overflow-y-auto">
        <div class="flex min-h-full items-end justify-center p-4 text-center sm:items-center sm:p-0">
            <div class="relative transform overflow-hidden rounded-2xl bg-white text-left shadow-2xl transition-all sm:my-8 sm:w-full sm:max-w-lg border border-gray-100">
                <div class="bg-white px-6 pb-6 pt-6 sm:p-8">
                    <div class="flex justify-between items-center mb-6">
                        <div>
                            <h3 class="text-xl font-bold text-gray-900 leading-tight" id="modal-title">Nueva Reserva</h3>
                            <p class="text-sm text-gray-500 mt-1">Completa los datos del huésped.</p>
                        </div>
                        <button type="button" id="btn-cerrar-modal" class="text-gray-400 hover:text-gray-600 focus:outline-none">
                            <span class="sr-only">Cerrar</span>
                            <svg class="h-6 w-6" fill="none" viewBox="0 0 24 24" stroke-width="1.5" stroke="currentColor">
                                <path stroke-linecap="round" stroke-linejoin="round" d="M6 18L18 6M6 6l12 12" />
                            </svg>
                        </button>
                    </div>
                    
                    <form id="form-crear" class="space-y-4">
                        <div>
                            <input type="text" id="nombre" class="w-full bg-gray-50 border border-gray-200 rounded-lg px-4 py-3 text-sm focus:outline-none focus:ring-2 focus:ring-brand-500 transition-shadow" placeholder="Nombre del Huésped" required>
                        </div>
                        <div>
                            <input type="email" id="email" class="w-full bg-gray-50 border border-gray-200 rounded-lg px-4 py-3 text-sm focus:outline-none focus:ring-2 focus:ring-brand-500 transition-shadow" placeholder="Correo Electrónico" required>
                        </div>
                        <div>
                            <input type="text" id="alojamiento" class="w-full bg-gray-50 border border-gray-200 rounded-lg px-4 py-3 text-sm focus:outline-none focus:ring-2 focus:ring-brand-500 transition-shadow" placeholder="Nombre del Alojamiento" required>
                        </div>
                        <div class="grid grid-cols-2 gap-4">
                            <input type="date" id="fecha_in" class="w-full bg-gray-50 border border-gray-200 rounded-lg px-4 py-3 text-sm text-gray-600 focus:outline-none focus:ring-2 focus:ring-brand-500" required>
                            <input type="date" id="fecha_out" class="w-full bg-gray-50 border border-gray-200 rounded-lg px-4 py-3 text-sm text-gray-600 focus:outline-none focus:ring-2 focus:ring-brand-500" required>
                        </div>
                        <div>
                            <input type="number" step="0.01" id="importe" class="w-full bg-gray-50 border border-gray-200 rounded-lg px-4 py-3 text-sm focus:outline-none focus:ring-2 focus:ring-brand-500 transition-shadow" placeholder="Importe Total (€)" required>
                        </div>
                        
                        <div class="mt-6 flex justify-end gap-3 pt-4 border-t border-gray-100">
                            <button type="button" id="btn-cancelar-modal" class="bg-white px-5 py-2.5 text-sm font-semibold text-gray-700 border border-gray-200 rounded-full hover:bg-gray-50 transition-colors">Cancelar</button>
                            <button type="submit" class="bg-brand-500 px-6 py-2.5 text-sm font-semibold text-gray-900 rounded-full hover:bg-brand-600 hover:shadow-brand transition-all">Confirmar Reserva</button>
                        </div>
                    </form>
                </div>
            </div>
        </div>
    </div>
</div>
{% endblock %}

{% block javascripts %}
    <script src="/js/reservas.js"></script>
{% endblock %}