{% extends "layout/base.html.twig" %}

{% block content %}
<div class="row mb-4">
    <!-- Formulario para crear reserva -->
    <div class="col-md-4">
        <div class="card shadow-sm">
            <div class="card-header bg-primary text-white">Nueva Reserva</div>
            <div class="card-body">
                <form id="form-crear">
                    <input type="text" id="nombre" class="form-control mb-2" placeholder="Nombre del Huésped" required>
                    <input type="email" id="email" class="form-control mb-2" placeholder="Email" required>
                    <input type="text" id="alojamiento" class="form-control mb-2" placeholder="Alojamiento" required>
                    <input type="date" id="fecha_in" class="form-control mb-2" required>
                    <input type="date" id="fecha_out" class="form-control mb-2" required>
                    <input type="number" step="0.01" id="importe" class="form-control mb-3" placeholder="Importe (€)" required>
                    <button type="submit" class="btn btn-primary w-100">Crear Reserva</button>
                </form>
            </div>
        </div>
    </div>

    <!-- Filtros y Tabla -->
    <div class="col-md-8">
        <div class="d-flex justify-content-between mb-3">
            <h4>Listado de Reservas</h4>
            <select id="filtro-estado" class="form-select w-auto">
                <option value="">Todos los estados</option>
                <option value="pendiente">Pendiente</option>
                <option value="confirmada">Confirmada</option>
                <option value="cancelada">Cancelada</option>
            </select>
        </div>
        
        <table class="table table-white table-striped shadow-sm">
            <thead>
                <tr>
                    <th>ID</th>
                    <th>Huésped</th>
                    <th>Alojamiento</th>
                    <th>Fechas</th>
                    <th>Estado</th>
                    <th>Acciones</th>
                </tr>
            </thead>
            <tbody id="tabla-reservas">
                {% for reserva in reservas %}
                    <tr id="reserva-{{ reserva.id }}">
                        <td>{{ reserva.id }}</td>
                        <td>{{ reserva.nombre_huesped }}</td>
                        <td>{{ reserva.nombre_alojamiento }}</td>
                        <td>{{ reserva.fecha_entrada }} / {{ reserva.fecha_salida }}</td>
                        <td>
                            <span class="badge bg-{{ reserva.estado == 'pendiente' ? 'warning' : (reserva.estado == 'confirmada' ? 'success' : 'danger') }}">
                                {{ reserva.estado|capitalize }}
                            </span>
                        </td>
                        <td>
                            <a href="/detalle?id={{ reserva.id }}" class="btn btn-sm btn-info text-white">Ver</a>
                            {% if reserva.estado != 'cancelada' %}
                                <button onclick="cancelarReserva({{ reserva.id }})" class="btn btn-sm btn-danger">Cancelar</button>
                            {% endif %}
                        </td>
                    </tr>
                {% endfor %}
            </tbody>
        </table>
    </div>
</div>
{% endblock %}

{% block javascripts %}
    <!-- Enlazamos nuestro archivo JS -->
    <script src="/js/reservas.js"></script>
{% endblock %}