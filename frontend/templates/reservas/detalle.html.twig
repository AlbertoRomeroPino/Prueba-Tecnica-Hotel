{% extends "layout/base.html.twig" %}

{% block content %}
<!-- Botón volver -->
<div class="mb-6">
    <a href="/" class="text-brand-600 hover:text-brand-700 font-bold text-sm flex items-center gap-2 transition-colors">
        <svg class="w-4 h-4" fill="none" stroke="currentColor" viewBox="0 0 24 24"><path stroke-linecap="round" stroke-linejoin="round" stroke-width="2" d="M10 19l-7-7m0 0l7-7m-7 7h18"></path></svg>
        Volver al listado
    </a>
</div>

<div class="flex flex-col sm:flex-row justify-between items-start sm:items-center mb-8 gap-4">
    <h1 class="text-3xl font-extrabold text-gray-900 tracking-tight">Detalle de la Reserva #{{ reserva.id }}</h1>
    
    {% if reserva.estado == 'pendiente' %}
        <span class="bg-brand-50 text-brand-700 border border-brand-200 rounded-full px-4 py-1.5 text-sm font-bold shadow-sm">Pendiente</span>
    {% elseif reserva.estado == 'confirmada' %}
        <span class="bg-green-50 text-green-700 border border-green-200 rounded-full px-4 py-1.5 text-sm font-bold shadow-sm">Confirmada</span>
    {% else %}
        <span class="bg-red-50 text-red-700 border border-red-200 rounded-full px-4 py-1.5 text-sm font-bold shadow-sm">Cancelada</span>
    {% endif %}
</div>

<div class="grid grid-cols-1 lg:grid-cols-3 gap-8 items-start">
    
    <!-- Columna Izquierda: Datos de la Reserva -->
    <div class="lg:col-span-2 space-y-6">
        <div class="bg-white rounded-2xl p-6 md:p-8 border border-gray-100 shadow-sm hover:shadow-md transition-shadow">
            <h2 class="text-xl font-bold text-gray-900 border-b border-gray-100 pb-4 mb-6">Información del Huésped y Estancia</h2>
            
            <div class="grid grid-cols-1 md:grid-cols-2 gap-y-8 gap-x-6">
                <div>
                    <p class="text-xs text-gray-500 uppercase font-bold tracking-wider">Huésped Principal</p>
                    <p class="text-base font-semibold text-gray-900 mt-1">{{ reserva.nombre_huesped }}</p>
                    <p class="text-sm text-gray-600 mt-0.5">{{ reserva.email_huesped }}</p>
                </div>
                <div>
                    <p class="text-xs text-gray-500 uppercase font-bold tracking-wider">Alojamiento</p>
                    <p class="text-base font-semibold text-gray-900 mt-1">{{ reserva.nombre_alojamiento }}</p>
                </div>
                <div>
                    <p class="text-xs text-gray-500 uppercase font-bold tracking-wider">Fecha de Entrada</p>
                    <p class="text-base font-semibold text-gray-900 mt-1">{{ reserva.fecha_entrada }}</p>
                </div>
                <div>
                    <p class="text-xs text-gray-500 uppercase font-bold tracking-wider">Fecha de Salida</p>
                    <p class="text-base font-semibold text-gray-900 mt-1">{{ reserva.fecha_salida }}</p>
                </div>
                <div class="md:col-span-2 bg-gray-50 p-4 rounded-xl border border-gray-100 flex justify-between items-center mt-2">
                    <p class="text-sm text-gray-600 font-semibold uppercase tracking-wider">Importe Total</p>
                    <p class="text-2xl font-black text-brand-600">{{ reserva.importe }} €</p>
                </div>
            </div>
        </div>
    </div>

   
    <div class="lg:col-span-1">
        <div class="bg-white rounded-2xl p-6 md:p-8 border border-gray-100 shadow-sm">
            <h3 class="text-lg font-bold text-gray-900 mb-6">Historial de Eventos</h3>
            
            <!-- Contenedor con altura máxima y scroll -->
            <div class="max-h-[400px] overflow-y-auto pr-4 -mr-4">
                <div class="relative border-l-2 border-gray-100 ml-3">
                    {% for evento in eventos %}
                        <div class="mb-8 pl-6 relative group">
                            <!-- Punto del Timeline -->
                            <span class="absolute -left-[9px] top-1.5 h-4 w-4 rounded-full bg-white border-4 border-brand-400 group-hover:border-brand-600 transition-colors shadow-sm"></span>
                            
                            <!-- Fecha formateada y destacada -->
                            <time class="block text-xs font-bold text-brand-600 uppercase tracking-wider mb-1">
                                {{ evento.fecha_evento | date('d/m/Y - H:i') }}
                            </time>
                            
                            <p class="text-sm font-bold text-gray-900 leading-tight">{{ evento.tipo_evento | capitalize }}</p>
                            
                            {% if evento.descripcion %}
                                <p class="text-sm text-gray-600 mt-2 bg-gray-50 p-3 rounded-lg border border-gray-100">{{ evento.descripcion }}</p>
                            {% endif %}
                        </div>
                    {% else %}
                        <p class="text-sm text-gray-500 pl-4">No hay eventos registrados en esta reserva.</p>
                    {% endfor %}
                </div>
            </div>
        </div>
    </div>

</div>
{% endblock %}